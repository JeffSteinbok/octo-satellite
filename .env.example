# Optional: set a shared secret to require Bearer token auth
# OCTO_SHARED_SECRET=your-secret-here

# Override host/port if needed (defaults: 127.0.0.1:9001)
# OCTO_HOST=127.0.0.1
# OCTO_PORT=9001

# Reject requests from non-loopback clients (default: true)
# Defense-in-depth: even if accidentally bound to 0.0.0.0, remote clients get 403
# OCTO_LOCALHOST_ONLY=true

# Persistent data paths
# OCTO_AMAZON_SESSION_DIR=~/.config/octo-satellite/amazon
# OCTO_COSTCO_SESSION_DIR=~/.config/octo-satellite/costco
# OCTO_AUDIT_LOG_DIR=~/.config/octo-satellite/logs
